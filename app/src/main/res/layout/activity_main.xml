<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Clothes Collection"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#263B65"
            android:gravity="center"
            android:padding="16dp" />

        <EditText
            android:id="@+id/etId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Clothes ID (for Update/Delete)"
            android:inputType="number"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dress Name"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Category (Shirt, Jeans, etc.)"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etColour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Colour"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Clothes"
            android:backgroundTint="#287A55"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Clothes"
            android:backgroundTint="#2866B2"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Clothes"
            android:backgroundTint="#D18A25"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Clothes"
            android:backgroundTint="#C43D45"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Clothes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#263B65"
            android:paddingTop="20dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your saved clothes will appear here."
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:minHeight="100dp" />

    </LinearLayout>

</ScrollView>
